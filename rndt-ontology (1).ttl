@prefix rndt: <http://www.cranfield.ac.uk/rndt-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.cranfield.ac.uk/rndt-ontology> rdf:type owl:Ontology ;
    rdfs:label "Remote NDT Ontology"@en ;
    rdfs:comment "An ontology of the Remote Non-Destructive Testing (RNDT) process, worked through a Digital Radiography example: 56 individuals, 77 relationships, 11 classes, 15 object properties across 5 relationship families (backbone/taxonomy, authority, role, evidence/info, sequence)."@en .

#################################################################
#    Classes
#################################################################

rndt:RemoteNDTProcess rdf:type owl:Class ;
    rdfs:label "RemoteNDTProcess"@en ;
    rdfs:comment "The top-level remote non-destructive testing process instance being modelled (e.g. a specific Digital Radiography inspection process)."@en .

rndt:ProcessStage rdf:type owl:Class ;
    rdfs:label "ProcessStage"@en ;
    rdfs:comment "A major temporal stage of a Remote NDT Process (e.g. Data Acquisition, Evaluation, Oversight)."@en .

rndt:MajorAction rdf:type owl:Class ;
    rdfs:label "MajorAction"@en ;
    rdfs:comment "A cognitive/functional action (aligned to the Sense-Act-Analyse-Verify-Decision-Sentence-Acquire authority model) through which a Process Stage is realised."@en .

rndt:ActionArea rdf:type owl:Class ;
    rdfs:label "ActionArea"@en ;
    rdfs:comment "A functional grouping of related activities nested beneath a Major Action."@en .

rndt:Activity rdf:type owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "A concrete, performable task within an Action Area, typically carried out by a Participant."@en .

rndt:Capability rdf:type owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:comment "A technical capability required to support one or more activities."@en .

rndt:RequirementConcept rdf:type owl:Class ;
    rdfs:label "RequirementConcept"@en ;
    rdfs:comment "A requirement or condition that must be satisfied as part of a process element (e.g. a documentation requirement)."@en .

rndt:PhysicalEntity rdf:type owl:Class ;
    rdfs:label "PhysicalEntity"@en ;
    rdfs:comment "A physical object or component involved in or produced by the process."@en .

rndt:InformationEntity rdf:type owl:Class ;
    rdfs:label "InformationEntity"@en ;
    rdfs:comment "A data or information artefact produced, transformed, or consumed by the process (e.g. images, records)."@en .

rndt:AuthorityClass rdf:type owl:Class ;
    rdfs:label "AuthorityClass"@en ;
    rdfs:comment "A defined level of inspection/evaluation/governance authority (e.g. Level 1, 2, 3) that authorises Major Actions."@en .

rndt:Participant rdf:type owl:Class ;
    rdfs:label "Participant"@en ;
    rdfs:comment "A human role that performs Activities (e.g. Operator, Inspector, Verifier)."@en .

rndt:Software rdf:type owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:comment "A software application used to view, process or interpret inspection data (e.g. a DICONDE viewer). Introduced to answer CQ-10; no existing class fits, since Software is neither a physical component nor an information artefact produced by the process."@en .

rndt:Facility rdf:type owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:comment "An organisational site at which an inspection or interpretation is carried out. Introduced to answer CQ-23; Participant is reserved for human roles, so a facility has no existing home."@en .

#################################################################
#    Annotation properties
#################################################################

rndt:relationshipFamily rdf:type owl:AnnotationProperty ;
    rdfs:label "relationshipFamily"@en ;
    rdfs:comment "Groups an object property into one of the five relationship families used in the knowledge-graph visualisation: backbone (taxonomy), authority, role, evidence/info, sequence."@en .

rndt:exactSourceTerm rdf:type owl:AnnotationProperty ;
    rdfs:label "exactSourceTerm"@en ;
    rdfs:comment "Records the verbatim wording of a term as it appears in the source Draw.io view and the Taxonomy Term Register, where rdfs:label carries a normalised preferred term instead. Preserves the register's rule that exact source wording is never deleted."@en .

#################################################################
#    Datatype properties
#################################################################

rndt:termId rdf:type owl:DatatypeProperty ;
    rdfs:label "termId"@en ;
    rdfs:comment "The controlled-vocabulary term identifier (e.g. TERM-nnnn, AUTH-nnn) assigned to this individual in the RNDT terminology register."@en ;
    rdfs:range xsd:string .

rndt:procedureRevision rdf:type owl:DatatypeProperty ;
    rdfs:label "procedureRevision"@en ;
    rdfs:comment "The revision identifier of the procedure or work instruction applied to an inspection (CQ-05)."@en ;
    rdfs:range xsd:string .

rndt:storageLocation rdf:type owl:DatatypeProperty ;
    rdfs:label "storageLocation"@en ;
    rdfs:comment "The repository path or archive location at which a digital image or record is held (CQ-15)."@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range xsd:string .

rndt:fileFormat rdf:type owl:DatatypeProperty ;
    rdfs:label "fileFormat"@en ;
    rdfs:comment "The file format of a stored digital image or record, e.g. DICONDE (CQ-16)."@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range xsd:string .

rndt:partNumber rdf:type owl:DatatypeProperty ;
    rdfs:label "partNumber"@en ;
    rdfs:comment "The part number of a physical component under inspection."@en ;
    rdfs:domain rndt:PhysicalEntity ;
    rdfs:range xsd:string .

rndt:serialNumber rdf:type owl:DatatypeProperty ;
    rdfs:label "serialNumber"@en ;
    rdfs:comment "The serial number uniquely identifying an individual physical component (CQ-17)."@en ;
    rdfs:domain rndt:PhysicalEntity ;
    rdfs:range xsd:string .

rndt:hasRole rdf:type owl:DatatypeProperty ;
    rdfs:label "hasRole"@en ;
    rdfs:comment "The role a Participant occupies, e.g. Operator, Inspector, Verifier."@en ;
    rdfs:domain rndt:Participant ;
    rdfs:range xsd:string .

rndt:inspectionDate rdf:type owl:DatatypeProperty ;
    rdfs:label "inspectionDate"@en ;
    rdfs:comment "The date on which a Remote NDT Process was carried out."@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range xsd:date .

rndt:disposition rdf:type owl:DatatypeProperty ;
    rdfs:label "disposition"@en ;
    rdfs:comment "The sentencing outcome of an inspection, e.g. Accept or Reject (CQ-11, CQ-20)."@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range xsd:string .

rndt:logDate rdf:type owl:DatatypeProperty ;
    rdfs:label "logDate"@en ;
    rdfs:comment "The date on which the activity recorded by an activity-log entry was performed."@en ;
    rdfs:range xsd:date .

rndt:logResult rdf:type owl:DatatypeProperty ;
    rdfs:label "logResult"@en ;
    rdfs:comment "The outcome recorded against an activity-log entry, e.g. Complete, No indications found."@en ;
    rdfs:range xsd:string .

#################################################################
#    Object properties
#################################################################

# ---- Relationship family: backbone (taxonomy) ----

rndt:hasProcessStage rdf:type owl:ObjectProperty ;
    rdfs:label "hasProcessStage"@en ;
    rdfs:comment "Relates a Remote NDT Process to one of its constituent Process Stages."@en ;
    rndt:relationshipFamily "backbone (taxonomy)"@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range rndt:ProcessStage .

rndt:realisedThrough rdf:type owl:ObjectProperty ;
    rdfs:label "realisedThrough"@en ;
    rdfs:comment "Relates a Process Stage to the Major Action(s) through which it is functionally realised."@en ;
    rndt:relationshipFamily "backbone (taxonomy)"@en ;
    rdfs:domain rndt:ProcessStage ;
    rdfs:range rndt:MajorAction .

rndt:hasSubActivity rdf:type owl:ObjectProperty ;
    rdfs:label "hasSubActivity"@en ;
    rdfs:comment "Relates a Major Action to a subordinate Action Area it decomposes into."@en ;
    rndt:relationshipFamily "backbone (taxonomy)"@en ;
    rdfs:domain rndt:MajorAction ;
    rdfs:range rndt:ActionArea .

rndt:requiresAction rdf:type owl:ObjectProperty ;
    rdfs:label "requiresAction"@en ;
    rdfs:comment "Relates an Action Area to a concrete Activity it requires to be performed."@en ;
    rndt:relationshipFamily "backbone (taxonomy)"@en ;
    rdfs:domain rndt:ActionArea ;
    rdfs:range rndt:Activity .

rndt:requiresCapability rdf:type owl:ObjectProperty ;
    rdfs:label "requiresCapability"@en ;
    rdfs:comment "Relates an Action Area to a Capability it depends on."@en ;
    rndt:relationshipFamily "backbone (taxonomy)"@en ;
    rdfs:domain rndt:ActionArea ;
    rdfs:range rndt:Capability .

rndt:hasRequirement rdf:type owl:ObjectProperty ;
    rdfs:label "hasRequirement"@en ;
    rdfs:comment "Relates an Action Area to a Requirement Concept that constrains it."@en ;
    rndt:relationshipFamily "backbone (taxonomy)"@en ;
    rdfs:domain rndt:ActionArea ;
    rdfs:range rndt:RequirementConcept .

# ---- Relationship family: authority ----

rndt:authorisedBy rdf:type owl:ObjectProperty ;
    rdfs:label "authorisedBy"@en ;
    rdfs:comment "Relates a Major Action to the Authority Class that authorises its performance."@en ;
    rndt:relationshipFamily "authority"@en ;
    rdfs:domain rndt:MajorAction ;
    rdfs:range rndt:AuthorityClass .

rndt:associatedWithAuthority rdf:type owl:ObjectProperty ;
    rdfs:label "associatedWithAuthority"@en ;
    rdfs:comment "Relates a Process Stage to the Authority Class with overall responsibility for it."@en ;
    rndt:relationshipFamily "authority"@en ;
    rdfs:domain rndt:ProcessStage ;
    rdfs:range rndt:AuthorityClass .

rndt:memberOfAuthorityClass rdf:type owl:ObjectProperty ;
    rdfs:label "memberOfAuthorityClass"@en ;
    rdfs:comment "Relates a Participant to the Authority Class they are certified to, i.e. their certification level (CQ-03, CQ-07)."@en ;
    rndt:relationshipFamily "authority"@en ;
    rdfs:domain rndt:Participant ;
    rdfs:range rndt:AuthorityClass .

# ---- Relationship family: role ----

rndt:performedBy rdf:type owl:ObjectProperty ;
    rdfs:label "performedBy"@en ;
    rdfs:comment "Relates an Activity to the Participant role that carries it out."@en ;
    rndt:relationshipFamily "role"@en ;
    rdfs:domain rndt:Activity ;
    rdfs:range rndt:Participant .

# ---- Relationship family: evidence / info ----

rndt:producesEvidence rdf:type owl:ObjectProperty ;
    rdfs:label "producesEvidence"@en ;
    rdfs:comment "Relates an Activity to an Information Entity it generates as evidence."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:Activity ;
    rdfs:range rndt:InformationEntity .

rndt:usesEntity rdf:type owl:ObjectProperty ;
    rdfs:label "usesEntity"@en ;
    rdfs:comment "Relates an Action Area to a Physical Entity it acts upon."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:ActionArea ;
    rdfs:range rndt:PhysicalEntity .

rndt:usesInformation rdf:type owl:ObjectProperty ;
    rdfs:label "usesInformation"@en ;
    rdfs:comment "Relates an Action Area to an Information Entity it consumes or references."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:ActionArea ;
    rdfs:range rndt:InformationEntity .

rndt:derivedFrom rdf:type owl:ObjectProperty ;
    rdfs:label "derivedFrom"@en ;
    rdfs:comment "Relates an Information Entity to another Information Entity it was derived from."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range rndt:InformationEntity .

rndt:supports rdf:type owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    rdfs:comment "Relates a Capability to the Activity it technically supports."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:Capability ;
    rdfs:range rndt:Activity .

rndt:belongsToInspection rdf:type owl:ObjectProperty ;
    rdfs:label "belongsToInspection"@en ;
    rdfs:comment "Relates an Information Entity (image, record or report) to the Remote NDT Process it was produced for (CQ-01, CQ-12, CQ-17)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range rndt:RemoteNDTProcess .

# ---- Relationship family: evidence / info (competency-question extension) ----
# Because Procedure, Specification, Acceptance Criteria, Inspection Report and
# Indication are modelled as individuals of rndt:InformationEntity rather than as
# their own classes, the predicate is what distinguishes them. Each property below
# therefore names the kind of artefact it points at.

rndt:usesProcedure rdf:type owl:ObjectProperty ;
    rdfs:label "usesProcedure"@en ;
    rdfs:comment "Relates a Remote NDT Process to the procedure or work instruction it was carried out under (CQ-04)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range rndt:InformationEntity .

rndt:approvedBy rdf:type owl:ObjectProperty ;
    rdfs:label "approvedBy"@en ;
    rdfs:comment "Relates a procedure or other controlled document to the Participant who approved it (CQ-06)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range rndt:Participant .

rndt:usesAcceptanceCriteria rdf:type owl:ObjectProperty ;
    rdfs:label "usesAcceptanceCriteria"@en ;
    rdfs:comment "Relates a Remote NDT Process to the acceptance criteria applied to it (CQ-08)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range rndt:InformationEntity .

rndt:appliesAcceptanceCriteria rdf:type owl:ObjectProperty ;
    rdfs:label "appliesAcceptanceCriteria"@en ;
    rdfs:comment "Relates an individual indication to the acceptance criteria used to evaluate it (CQ-21)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range rndt:InformationEntity .

rndt:usesEquipment rdf:type owl:ObjectProperty ;
    rdfs:label "usesEquipment"@en ;
    rdfs:comment "Relates a Remote NDT Process to the equipment used to perform it (CQ-09). Deliberately distinct from usesEntity, which is reserved for the component under inspection."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range rndt:PhysicalEntity .

rndt:viewedWithSoftware rdf:type owl:ObjectProperty ;
    rdfs:label "viewedWithSoftware"@en ;
    rdfs:comment "Relates a digital image or record to the Software used to view or interpret it (CQ-10)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range rndt:Software .

rndt:appliesSpecification rdf:type owl:ObjectProperty ;
    rdfs:label "appliesSpecification"@en ;
    rdfs:comment "Relates a Remote NDT Process to the governing specification, code or standard that applies to it (CQ-14)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range rndt:InformationEntity .

rndt:performedAtFacility rdf:type owl:ObjectProperty ;
    rdfs:label "performedAtFacility"@en ;
    rdfs:comment "Relates a Remote NDT Process to the Facility at which it was performed or interpreted (CQ-23)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:RemoteNDTProcess ;
    rdfs:range rndt:Facility .

rndt:hasIndication rdf:type owl:ObjectProperty ;
    rdfs:label "hasIndication"@en ;
    rdfs:comment "Relates a radiographic image to an individual indication identified within it (CQ-22)."@en ;
    rndt:relationshipFamily "evidence / info"@en ;
    rdfs:domain rndt:InformationEntity ;
    rdfs:range rndt:InformationEntity .

# ---- Relationship family: audit / provenance ----
# An activity-log entry reifies "who did which activity, on which inspection, when".
# It is what allows a named person to be traced to a named activity on a named
# inspection, and is what CQ-02, CQ-03, CQ-13, CQ-18 and CQ-19 depend on.

rndt:logsActivity rdf:type owl:ObjectProperty ;
    rdfs:label "logsActivity"@en ;
    rdfs:comment "Relates an activity-log entry to the Activity it records."@en ;
    rndt:relationshipFamily "audit / provenance"@en ;
    rdfs:range rndt:Activity .

rndt:logForInspection rdf:type owl:ObjectProperty ;
    rdfs:label "logForInspection"@en ;
    rdfs:comment "Relates an activity-log entry to the Remote NDT Process it was performed on."@en ;
    rndt:relationshipFamily "audit / provenance"@en ;
    rdfs:range rndt:RemoteNDTProcess .

rndt:logPerformedBy rdf:type owl:ObjectProperty ;
    rdfs:label "logPerformedBy"@en ;
    rdfs:comment "Relates an activity-log entry to the Participant who performed the activity. Unlike performedBy, which attributes an Activity to a role at the schema level, this attributes a specific occurrence to a named individual."@en ;
    rndt:relationshipFamily "audit / provenance"@en ;
    rdfs:range rndt:Participant .

# ---- Relationship family: sequence ----

rndt:precedes rdf:type owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:comment "Relates a Process Stage to the Process Stage that temporally follows it."@en ;
    rndt:relationshipFamily "sequence"@en ;
    rdfs:domain rndt:ProcessStage ;
    rdfs:range rndt:ProcessStage .


