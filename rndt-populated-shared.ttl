@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rndt: <http://www.cranfield.ac.uk/rndt-ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rndt:LOG_0001 a owl:NamedIndividual ;
    rndt:logDate "2026-02-15"^^xsd:date ;
    rndt:logPerformedBy rndt:P_VER_01 ;
    rndt:logsActivity rndt:SelectNDTMethodAndTechnique .

rndt:LOG_0002 a owl:NamedIndividual ;
    rndt:logDate "2026-02-15"^^xsd:date ;
    rndt:logPerformedBy rndt:P_VER_01 ;
    rndt:logsActivity rndt:PrepareRNDTProcedure .

rndt:P_INS_01 a rndt:Participant,
        owl:NamedIndividual ;
    rdfs:label "David Whitfield"@en ;
    rndt:hasRole rndt:Inspector ;
    rndt:memberOfAuthorityClass rndt:Level2TechnicalEvaluationAuthority .

rndt:P_OP_03 a rndt:Participant,
        owl:NamedIndividual ;
    rdfs:label "Aisha Rahman"@en ;
    rndt:hasRole rndt:Operator ;
    rndt:memberOfAuthorityClass rndt:Level1InspectionExecutionAuthority .

rndt:SPEC_001 a rndt:InformationEntity,
        owl:NamedIndividual ;
    rdfs:label "NANDTB/29 remote NDT requirements"@en .

rndt:P_VER_01 a rndt:Participant,
        owl:NamedIndividual ;
    rdfs:label "Thomas Okafor"@en ;
    rndt:hasRole rndt:Verifier ;
    rndt:memberOfAuthorityClass rndt:Level3GovernanceAndAssuranceAuthority .

